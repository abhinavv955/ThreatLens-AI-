# NutriTrack AI - Environment Configuration

# Backend API Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & JWT Auth
SECRET_KEY=nutritrack_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with SQLite local dev fallback)
DATABASE_URL=postgresql://nutritrack_user:password@localhost:5432/nutritrack_db
# For quick local SQLite development if PostgreSQL is not running:
# DATABASE_URL=sqlite:///./nutritrack.db

# AI & External Services
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=NutriTrack AI
